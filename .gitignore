# ── Node / Next.js ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-*/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets — never commit ──────────────────────────────────────────────────
.env
# Backups and drafts of it too. `.env` matches only that exact name, so a
# `.env.bak-1787893615` written beside it sat untracked and would have gone
# in with the next `git add -A`, carrying every live key with it.
.env.bak*
.env.backup*
.env.save*
.env.local
.env.*.local
!.env.example

# ── Large geospatial rasters (fetched by `make data`, never committed) ──────
backend/data/raw/
*.tif
*.tiff
*.img
*.zip

# ── Generated artifacts ─────────────────────────────────────────────────────
backend/var/
backend/var/reports/
*.pdf
!docs/**/*.pdf

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# ── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── CoolRx update bundle (local-only, not part of the repo) ─────────────────
coolrx-apply.ps1
coolrx-changes.patch
coolrx-commit-msg.txt
