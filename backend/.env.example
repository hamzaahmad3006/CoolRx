# =============================================================================
# CoolRx backend configuration
# Copy to .env and fill in. NEVER commit a filled .env.
# =============================================================================

# ----------------------------------------------------------------- APP / CORE
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=console
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --------------------------------------------------------------------- DATABASE
DATABASE_URL=postgresql+psycopg://coolrx:coolrx@localhost:5432/coolrx
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

# ------------------------------------------------------------------------ REDIS
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=coolrx
JOB_DEADLINE_SECONDS=1800

# ------------------------------------------------------- FORTYGUARD API (SECRET)
# Emailed after hackathon registration. Backend only — NEVER sent to the browser.
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# TO VERIFY day 1: which plan hackathon participants receive is undocumented.
FG_PLAN=basic
FG_MAX_AOI_SQMI=10.0

# Docs say 2019-01-01, the hackathon FAQ says 2021-01-01. Stricter is safer.
FG_DATE_FLOOR=2021-01-01

FG_DEFAULT_GRANULARITY=80
FG_DEFAULT_THRESHOLD_C=35.0
FG_LADDER_STEPS=10
FG_MAX_FORECAST_HOURS=12

FG_POLL_INITIAL_SECONDS=2
FG_POLL_MAX_SECONDS=30
FG_POLL_DEADLINE_SECONDS=600
FG_MAX_CONCURRENT_SUBMISSIONS=2
FG_BREAKER_FAILURE_THRESHOLD=5
FG_BREAKER_COOLDOWN_SECONDS=120

# Premium-only endpoints. Default OFF so a 403 changes nothing in the MVP.
FG_ENABLE_SATELLITE=false
FG_ENABLE_STREETVIEW=false
FG_ENABLE_HEAT_INTELLIGENCE=false

# Credit protection.
FG_CREDIT_RESERVE=50000
FG_DAILY_SUBMISSION_CAP=200

# ------------------------------------------------------------ FIXTURE / DEMO MODE
FIXTURE_MODE=true
FIXTURE_DIR=./data/fixtures
FIXTURE_STRICT=true

# ------------------------------------------------------------- LANGUAGE MODEL
# Which provider narrates a plan.
#   auto      prefer Anthropic, fall back to Groq — set either key and it works
#   anthropic force Anthropic, no fallback
#   groq      force Groq
#   none      no narration at all
#
# Narration is OPTIONAL. Plans generate correctly with no key: items simply carry
# no written rationale and the report says so. Every number originates from the
# API, the database, the model or arithmetic — never from the language model —
# which is what makes leaving this unset safe rather than a degradation.
#
# Leave a key BLANK rather than setting one you know is out of credit: a dead key
# costs a failed round-trip per plan before it degrades.
LLM_PROVIDER=auto

# ------------------------------------------------------------- ANTHROPIC (SECRET)
# Needs prepaid API credits. A claude.ai Free or Pro subscription does NOT include
# them — console.anthropic.com billing is separate.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MODEL_RATIONALE=claude-opus-5
LLM_EFFORT_REPORT=high
LLM_EFFORT_RATIONALE=medium
# NOTE: on claude-opus-5 this caps thinking AND response text together.
LLM_MAX_TOKENS_REPORT=16000
LLM_MAX_TOKENS_RATIONALE=2000
LLM_ENABLE_PROMPT_CACHE=true
LLM_STREAM_REPORT=true
# Do NOT add temperature/top_p/top_k — rejected with 400 on claude-opus-5.

# ------------------------------------------------------------------ GROQ (SECRET)
# Free tier, no card required: console.groq.com/keys
# Limits at time of writing: 30 requests/min, 14,400/day, 6,000 tokens/min.
# A plan is ~1 call per item plus a summary, so a normal run fits comfortably.
#
# Note: open-weight models fabricate figures more often than frontier models, so
# the numeric guard will actually fire. That is the design working — the caught
# violations appear on the Agent Trace page and the figures are unaffected.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------- ML / MODEL
MODEL_DIR=./models
MODEL_VERSION=trm-2026.08.22-a3f1
MODEL_STRICT_VERSION_CHECK=true

# ---------------------------------------------------------------- AUTH / LIMITS
# Gates the endpoints that spend FortyGuard credits. Required in production.
DEMO_KEY=
RATE_LIMIT_WRITE_PER_HOUR=5
RATE_LIMIT_READ_PER_MINUTE=300

# ------------------------------------------------------------------ MONITORING
SENTRY_DSN=
ENABLE_METRICS_ENDPOINT=true
